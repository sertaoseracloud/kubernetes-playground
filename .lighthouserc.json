{
  "ci": {
    "collect": {
      "startServerCommand": "npx astro preview --port 4321",
      "startServerReadyPattern": "localhost:4321",
      "numberOfRuns": 3,
      "url": [
        "http://localhost:4321/kubernetes-playground/",
        "http://localhost:4321/kubernetes-playground/trilha/",
        "http://localhost:4321/kubernetes-playground/p/pods-restart-policy/"
      ]
    },
    "assert": {
      "assertions": {
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.8 }],
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
